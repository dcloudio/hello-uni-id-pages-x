<template>
	<view class="page">测试数据清理：删除测试账号</view>
</template>

<script setup lang="uts">
	const testAccountCleaner = uniCloud.importObject("e2e-test-account-cleaner", { "customUI": true })

	function clearLocalLoginState() {
		uni.removeStorageSync("uni_id_token")
		uni.setStorageSync("uni_id_token_expired", 0)
		uni.removeStorageSync("uni-id-pages-x-userInfo")
	}

	async function deleteRegisteredE2eTestAccount(paramString : string) : Promise<any> {
		const param = JSON.parseObject(paramString)!
		const testRes = await new Promise((resolve) => {
			testAccountCleaner.deleteRegisteredE2eTestAccount(param)
				.then<void>((e : UTSJSONObject) : void => {
					console.log('e',e)
					resolve(e)
				})
				.catch<void>((err : any | null) : void => {
					const error = err as UniCloudError
					let errCode = error.errCode
					if (errCode == null) {
						errCode = error.code
					}
					let errMsg = error.errMsg
					if (errMsg == null) {
						errMsg = error.message
					}
					resolve({ errCode: errCode, errMsg: errMsg })
				})
				.finally(() : void => {
					clearLocalLoginState()
				})
		})
		return testRes
	}

	defineExpose({
		deleteRegisteredE2eTestAccount
	})
</script>

<style scoped>
	.page {
		flex: 1;
	}
</style>
