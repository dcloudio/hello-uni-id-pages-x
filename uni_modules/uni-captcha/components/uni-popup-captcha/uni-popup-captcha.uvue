<template>
  <uni-popup ref="popupRef" @clickMask="cancel">
    <view class="popup-captcha">
      <view class="content">
        <text class="title popup-captcha-title">{{title}}</text>
        <uni-captcha ref="captchaRef" :focus="focus" :scene="scene" v-model="val" :cursorSpacing="150"></uni-captcha>
      </view>
      <view class="button-box popup-captcha-button-box">
        <text @click="cancel" class="btn popup-captcha-btn popup-captcha-btn-cancel">取消</text>
        <text @click="confirm" class="btn confirm popup-captcha-btn popup-captcha-btn-confirm">确认</text>
      </view>
    </view>
  </uni-popup>
</template>

<script setup lang="uts">
  import uniPopup from './uni-popup/uni-popup.uvue';
  let confirmCallBack = ():void=>console.log('未传入回调函数')

  const emit = defineEmits(['input', 'update:modelValue', 'confirm', 'cancel'])
  const props = defineProps({
    modelValue: {
      type: String,
      default: ""
    },
    value: {
      type: String,
      default: ""
    },
    scene: {
      type: String,
      default: ""
    },
    title: {
      type: String,
      default: "默认标题"
    }
  })

  const popupRef = ref<ComponentPublicInstance | null>(null)
  const captchaRef = ref<ComponentPublicInstance | null>(null)
  const focus = ref(false)
  const val = ref("")

  const title = computed(() : string => {
    return props.title
  })

  const scene = computed(() : string => {
    return props.scene
  })

  function open(callback : () => void) {
    // console.log('callback',callback);
    confirmCallBack = callback
    focus.value = true
    val.value = ""
    popupRef.value!.$callMethod("open")
    nextTick(() => {
      captchaRef.value!.$callMethod("getImageCaptcha", true)
    })
  }

  function close() {
    focus.value = false
    popupRef.value!.$callMethod("close")
  }

  function cancel() {
    close()
    emit('cancel')
  }

  function confirm() {
    if (val.value.length != 4) {
      return uni.showToast({
        title: '请填写验证码',
        icon: 'none'
      })
    }
    close()
    emit('confirm')
    confirmCallBack()
  }

  watch(val, (value : string) => {
    // console.log(val);
    // TODO 兼容 vue2
    // #ifdef VUE2
    emit('input', value)
    // #endif

    // TODO　兼容　vue3
    // #ifdef VUE3
    emit('update:modelValue', value)
    // #endif

    if (value.length == 4) {
      confirm()
    }
  })

  defineExpose({
    open,
    close,
    cancel,
    confirm
  })
</script>

<style lang="scss" scoped>
  .popup-captcha {
    background-color: #fff;
    flex-direction: column;
    width: 600rpx;
    padding:10px 15px;
    border-radius: 10px;
  }
  .popup-captcha-title {
    text-align: center;
    font-weight: 700;
    margin: 5px 0;
  }
  .popup-captcha-button-box {
    flex-direction: row;
    justify-content: space-around;
    margin-top: 5px;
  }
  .popup-captcha-btn {
    flex: 1;
    height: 35px;
    line-height: 35px;
    text-align: center;
  }
  .popup-captcha-btn-cancel {
    border: 1px solid #eee;
    color: #666;
  }
  .popup-captcha-btn-confirm {
    background-color: #0070ff;
    color: #fff;
    margin-left: 5px;
  }
</style>
