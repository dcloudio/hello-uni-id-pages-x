<template>
  <uni-popup ref="popup" @clickMask="cancel">
    <view class="popup-captcha">
      <view class="content">
        <text class="popup-captcha-title">{{title}}</text>
        <uni-captcha ref="captcha" :focus="focus" :scene="scene" v-model="val" :cursorSpacing="150"></uni-captcha>
      </view>
      <view class="popup-captcha-button-box">
        <text @click="cancel" class="popup-captcha-btn popup-captcha-cancel">取消</text>
        <text @click="confirm" class="popup-captcha-btn popup-captcha-confirm">确认</text>
      </view>
    </view>
  </uni-popup>
</template>

<script setup lang="uts">
  let confirmCallBack = () : void => {
    console.log('未传入回调函数')
  }

  const emit = defineEmits(['input', 'confirm', 'cancel', 'update:modelValue'])
  const props = defineProps({
    modelValue: {
      type: String,
      default: ""
    },
    value: {
      type: String,
      default: ""
    },
    scene: {
      type: String,
      default: ""
    },
    title: {
      type: String,
      default: "默认标题"
    }
  })

  const popup = ref<UniPopupComponentPublicInstance | null>(null)
  const captcha = ref<UniCaptchaComponentPublicInstance | null>(null)
  const focus = ref(false)
  const val = ref("")

  const scene = computed(() : string => {
    return props.scene
  })

  const title = computed(() : string => {
    return props.title
  })

  function close() {
    focus.value = false
    popup.value!.close()
  }

  function cancel() {
    close()
    emit('cancel')
  }

  function confirm() {
    if (val.value.length != 4) {
      return uni.showToast({
        title: '请填写验证码',
        icon: 'none'
      })
    }
    close()
    emit('confirm')
    confirmCallBack()
  }

  function open(callback : () => void) {
    confirmCallBack = callback
    focus.value = true
    val.value = ""
    popup.value!.open()
    nextTick(() => {
      captcha.value!.getImageCaptcha(true)
    })
  }

  watch(() : string => props.value, (value : string) => {
    if (value != val.value) {
      val.value = value
    }
  }, {
    immediate: true
  })

  watch(() : string => props.modelValue, (modelValue : string) => {
    if (modelValue != val.value) {
      val.value = modelValue
    }
  }, {
    immediate: true
  })

  watch(val, (value : string) => {
    emit('input', value)
    emit('update:modelValue', value)

    if (value.length == 4) {
      confirm()
    }
  })

  defineExpose({
    open,
    close
  })
</script>

<style lang="scss" scoped>
  .popup-captcha {
    background-color: #fff;
    flex-direction: column;
    width: 600rpx;
    padding:10px 15px;
    border-radius: 10px;
  }
  .popup-captcha-title {
    text-align: center;
    font-weight: 700;
    margin: 5px 0;
  }
  .popup-captcha-button-box {
    flex-direction: row;
    justify-content: space-around;
    margin-top: 5px;
  }
  .popup-captcha-btn {
    flex: 1;
    height: 35px;
    line-height: 35px;
    text-align: center;
  }
  .popup-captcha-cancel {
    border: 1px solid #eee;
    color: #666;
  }
  .popup-captcha-confirm {
    background-color: #0070ff;
    color: #fff;
    margin-left: 5px;
  }
</style>
