<!-- 网络链接内容展示页（uni-id-pages-x中用于展示隐私政策协议内容） -->
<template>
	<web-view class="web-view" v-if="url.length != 0" :src="url"></web-view>
</template>

<script setup lang="uts">
	const url = ref("")

	onLoad((query : UTSJSONObject | null) => {
		const pageUrl = query?.getString("url") ?? ""
		let title = query?.getString("title") ?? ""
		if (pageUrl.substring(0, 4) != 'http') {
			uni.showModal({
				title: "错误",
				content: '不是一个有效的网站链接,' + '"' + pageUrl + '"',
				showCancel: false,
				confirmText: "知道了",
				complete: () => {
					uni.navigateBack()
				}
			})
			title = "页面路径错误"
		} else {
			url.value = pageUrl
		}
		if (title.length != 0) {
			uni.setNavigationBarTitle({ title })
		}
	})
</script>
<style>
	.web-view {
		width: 750rpx;
		flex: 1;
		height: 100%;
	}
</style>
