<template>
    <view>
        <template v-if="isCertify">
            <view class="list">
                <view class="list__item">
                    <view class="list__title">姓名</view>
                    <view class="list__content">
                        <text class="list__value">{{realnameInfo['realName']}}</text>
                    </view>
                </view>
                <view class="list__item">
                    <view class="list__title">身份证号码</view>
                    <view class="list__content">
                        <text class="list__value">{{realnameInfo['identity']}}</text>
                    </view>
                </view>
            </view>
        </template>
        <template v-else>
            <template v-if="verifyFail">
                <view class="fail-tip-content">
                    <view class="face-icon">
                        <image src="@/uni_modules/uni-id-pages-x/static/default-avatar.png" class="face-icon-image"/>
                    </view>
                    <view class="error-title">
                        <text class="text error-title__text">{{verifyFailTitle}}</text>
                    </view>
                    <view class="error-description">
                        <text class="text error-description__text">{{verifyFailContent}}</text>
                    </view>
                    <button type="primary" @click="retry" v-if="verifyFailCode != 10013">重新开始验证</button>
                    <button type="primary" @click="retry" v-else>返回</button>
                    <view class="dev-tip" v-if="isDev">请在控制台查看详细错误（此提示仅在开发环境展示）</view>
                </view>
            </template>
            <template v-else>
                <uni-id-pages-x-input class="input" v-model=" realName as string" placeholder="姓名" :focus="true"
                                      :maxlength="25"></uni-id-pages-x-input>
                <uni-id-pages-x-input class="input" v-model="idCard as string" placeholder="身份证号码"
                                      :maxlength="25"></uni-id-pages-x-input>
                <uni-id-pages-x-agreements scope="realNameVerify" ref="agreements"
                                           style="margin: 0 10px 10px;"></uni-id-pages-x-agreements>
                <button type="primary" :disabled="!certifyIdNext" @click="getCertifyId" style="margin: 0 10px;">确定
                </button>
            </template>
        </template>
    </view>
</template>

<script setup lang="uts">
    import {state, mutations} from '@/uni_modules/uni-id-pages-x/store.uts';

    const uniIdCo = uniCloud.importObject('uni-id-co')
    const tempFrvInfoKey = 'uni-id-pages-temp-frv'

    function checkIdCard(value : string) : boolean {
        return /^(\d{15}|\d{17}[\dXx])$/.test(value)
    }

    const realName = ref('')
    const idCard = ref('')
    const certifyId = ref('')
    const verifyFail = ref(false)
    const verifyFailCode = ref(0)
    const verifyFailTitle = ref('')
    const verifyFailContent = ref('')

    const userInfo = computed(() : UTSJSONObject => {
        return state.userInfo
    })

    const realnameInfo = computed(() : UTSJSONObject => {
        return userInfo.value.getJSON('realNameInfo') ?? ({} as UTSJSONObject)
    })

    const certifyIdNext = computed(() : boolean => {
        return realName.value !== '' && idCard.value !== '' && !state.pendingAgreements
    })

    const isCertify = computed(() : boolean => {
        return realnameInfo.value.getNumber('authStatus') == 2
    })

    const isDev = computed(() : boolean => {
        return process.env.NODE_ENV == 'development'
    })

    async function getFrvAuthResult() : Promise<void> {
        const frvUniIdCo = uniCloud.importObject('uni-id-co', {
            customUI: true
        })
        try {
            uni.showLoading({
                title: '验证中...',
                mask: false
            })
            const res : UTSJSONObject = await frvUniIdCo.getFrvAuthResult({
                certifyId: certifyId.value
            })

            if (verifyFailContent.value != '') {
                console.log(`[frv-debug] 客户端刷脸失败，由实人认证服务查询具体原因，原因：${verifyFailContent.value}`)
            }

            uni.showModal({
                content: '实名认证成功',
                showCancel: false,
                success: () => {
                    mutations.updateUserInfo({
                        realNameInfo: res
                    })
                    verifyFail.value = false
                }
            })

            uni.removeStorage({
                key: tempFrvInfoKey
            })
        } catch (e) {
            const error = e as UniCloudError
            verifyFail.value = true
            verifyFailTitle.value = error.errMsg
            console.error(JSON.stringify(e))
        }
        uni.hideLoading()
    }

    function startFacialRecognitionVerify() {
        uni.startFacialRecognitionVerify({
            certifyId: certifyId.value,
            progressBarColor: '#2979ff',
            success: () => {
                verifyFail.value = false
                getFrvAuthResult()
            },
            fail: (e : IFacialRecognitionVerifyError) => {
                let title = '验证失败'
                let content = ''

                console.log(
                    `[frv-debug] certifyId auth error: certifyId -> ${certifyId.value}, error -> ${JSON.stringify(e)}`
                )

                switch (e.errCode) {
                    case 10001:
                        content = '认证ID为空'
                        break
                    case 10010:
                        title = '刷脸异常'
                        content = e.cause?.message ?? '错误代码: 10010'
                        break
                    case 10011:
                        title = '验证中断'
                        content = e.cause?.message ?? '错误代码: 10011'
                        break
                    case 10012:
                        content = '网络异常'
                        break
                    case 10020:
                        content = '设备设置时间异常'
                        break
                    case 10013:
                        verifyFailCode.value = e.errCode
                        verifyFailContent.value = e.cause?.message ?? '错误代码: 10013'
                        getFrvAuthResult()

                        console.log(
                            `[frv-debug] 刷脸失败, certifyId -> ${certifyId.value}, 如在开发环境请检查用户的姓名、身份证号与刷脸用户是否为同一用户。如遇到认证ID已使用请检查opendb-frv-logs表中certifyId状态`
                        )
                        return
                    default:
                        title = ''
                        content = `验证未知错误 (${e.errCode})`
                        break
                }
                verifyFail.value = true
                verifyFailCode.value = e.errCode
                verifyFailTitle.value = title
                verifyFailContent.value = content
            }
        })
    }

    async function getCertifyId() : Promise<void> {
        if (!certifyIdNext.value) {
            return
        }

        if (!checkIdCard(idCard.value)) {
            uni.showToast({
                title: '身份证不合法',
                icon: 'none'
            })
            return
        }

        const reg = new RegExp('^[\u4e00-\u9fa5]{1,10}(·?[\u4e00-\u9fa5]{1,10}){0,5}', 'g')

        if (realName.value.length < 2 || !reg.test(realName.value)) {
            uni.showToast({
                title: '姓名只能是汉字',
                icon: 'none'
            })
            return
        }

        uni.setStorage({
            key: tempFrvInfoKey,
            data: {
                realName: realName.value,
                idCard: idCard.value
            }
        })

        const metaInfo = uni.getFacialRecognitionMetaInfo()
        const res : UTSJSONObject = await uniIdCo.getFrvCertifyId({
            realName: realName.value,
            idCard: idCard.value,
            metaInfo
        })

        if (res.getNumber('errCode') == 0) {
            return uni.showToast({
                title: res.getString('errMsg') as string,
                icon: 'none'
            })
        }

        certifyId.value = res.getString('certifyId') as string
        startFacialRecognitionVerify()
    }

    function retry() {
        if (verifyFailCode.value != 10013) {
            getCertifyId()
        } else {
            verifyFail.value = false
        }
    }
</script>

<style lang="scss">
  @import url("/uni_modules/uni-id-pages-x/common/common.scss");

  .list {
    position: relative;
    background-color: #fff;
    margin-top: 15px;

    &__item {
      border-bottom: 1px solid #f5f5f5;
      flex-direction: row;
      align-items: center;
      padding: 15px 15px;
    }

    &__title {
      flex: 1;
    }

    &__text {
      font-size: 14px;
      color: #333;
    }

    &__content {
      flex-direction: row;
      justify-content: center;
      align-items: center;
    }

    &__value {
      color: #999;
      font-size: 12px;
    }

    &__unset {
      color: #aaa;
      font-size: 12px;
    }
  }

  .input {
    background-color: #FFF;
  }

  .uni-label-pointer {
    align-items: center;
    display: flex;
    flex-direction: row;
  }

  .item {
    flex-direction: row;
  }

  .text {
    line-height: 26px;
  }

  .agreements {
    margin-bottom: 20px;
  }

  .fail-tip-content {
    padding: 20px;
  }

  .face-icon {
    width: 100px;
    height: 100px;
    margin: 50px auto 30px;
  }

  .face-icon-image {
    width: 100%;
    height: 100%;
  }

  .error-title__text {
    font-size: 18px;
    text-align: center;
    font-weight: bold;
  }

  .error-description {
    margin: 10px 0 20px;
  }

  .error-description__text {
    font-size: 13px;
    color: #999999;
    text-align: center;
  }

  .dev-tip {
    margin-top: 20px;
    font-size: 13px;
    color: #999;
    text-align: center;
  }
</style>
