<template>
	<view class="page">
		<view class="form">
			<!-- 获取验证码组件（输入手机号码+发送短信验证码所需的图形验证码，获得短信验证码） -->
			<uni-id-pages-x-smsCode scene="bind-mobile-by-sms" ref="smsCodeRef"
				@input="smsCodeInput" class="test-smsCode"></uni-id-pages-x-smsCode>
			<button class="uni-btn" type="primary" @click="sendSmsCode">获取验证码</button>
		</view>

		<!-- 多次登录错误时，获取登录时专用的图形验证码 （悬浮） -->
		<uni-popup-captcha @cancel="popupCaptchaCancel" ref="popupCaptchaRef" scene="bind-mobile-by-sms" v-model="data.captcha"
			title="请输入验证码"></uni-popup-captcha>
	</view>
</template>

<script setup lang="uts">
	type TypeTestErr = {
		errCode : string,
		errMsg : string
	}
	import { mutations } from '@/uni_modules/uni-id-pages-x/store.uts';
	const smsCodeRef = ref<UniIdPagesXSmsCodeComponentPublicInstance | null>(null)
	const popupCaptchaRef = ref<UniPopupCaptchaComponentPublicInstance | null>(null)
	
	// 使用reactive避免ref数据在自动化测试中无法访问
	const data = reactive({
		needCaptcha: false,
		captcha: '',
		testErr: {
			errCode: '',
			errMsg: ''
		} as TypeTestErr,
		testSuccess: 100,
		testState: false
	})

	function sendSmsCode() {
		smsCodeRef.value!.sendSmsCode()
	}

	function smsCodeInput(param : UTSJSONObject) {
		const mobile = param.getString("mobile") as string
		const code = param.getString("code") as string
		if (mobile.length == 11 && code.length == 6) {
			bindMobileBySms(param)
		}
	}

	async function bindMobileBySms(param : UTSJSONObject) : Promise<any> {
		console.log('param:--------- ', param)

		function setCaptchaRetry() {
			uni.showToast({
				title: '请输入验证码',
				icon: 'none',
				duration: 3000
			})
			popupCaptchaRef.value!.open(() => {
				bindMobileBySms(param)
			})
		}

		if (data.needCaptcha) {
			if (data.captcha.length != 4) {
				return setCaptchaRetry()
			}
			param.set("captcha", data.captcha)
		}

		uni.showLoading({ "title": "请求中" })
		const uniIdCo = uniCloud.importObject("uni-id-co", { "customUI": true })
		const testRes = await new Promise((resolve) => {
			uniIdCo.bindMobileBySms(param)
				.finally(() : void => {
					uni.hideLoading()
				})
				.then<void>((e : UTSJSONObject) : void => {
					data.testState = true
					console.log('then')
					console.log(e)
					data.testSuccess = e['errCode'] as number
					console.log(data.testSuccess)
					smsCodeRef.value!.hideCodeInput()

					uni.showToast({
						title: '绑定成功',
						icon: 'none',
						duration: 3000
					})
					mutations.updateUserInfo({
						"mobile": param.getString("mobile")
					} as UTSJSONObject)
					setTimeout(() => {
						uni.navigateBack()
					}, 300)
					resolve(e)
				})
				.catch<void>((err : any | null) : void => {
					data.testState = true
					const error = err as UniCloudError
					let errCode = error.errCode
					if (errCode == null) {
						errCode = error.code
					}
					let errMsg = error.errMsg
					if (errMsg == null) {
						errMsg = error.message
					}
					console.error(error)
					console.error(error.code)
					data.testErr.errCode = errCode as string
					data.testErr.errMsg = errMsg as string
					console.log(JSON.stringify(data.testErr))
					uni.showToast({
						title: error.message,
						icon: 'none',
						duration: 3000,
						mask: false
					})
					resolve({ errCode: errCode, errMsg: errMsg })
				})
		})
		return testRes
	}

	function bindMobileBySmsForTest(paramString : string) : Promise<any> {
		const param = JSON.parseObject(paramString)!
		return bindMobileBySms(param)
	}

	function popupCaptchaCancel() {
		smsCodeRef.value!.reset()
		data.captcha = ""
	}

	defineExpose({
		data,
		bindMobileBySmsForTest
	})
</script>

<style>
@import url("/uni_modules/uni-id-pages-x/common/common.scss");

.uni-btn {
	margin-top: 10px;
}
</style>
