<template>
	<view>
		<view class="form">
			<text class="pwd-login-title">账号密码登录</text>
			<uni-id-pages-x-input class="my-input" title="账号" placeholder="请输入手机号/用户名/邮箱" v-model="data.username" ref="usernameRef"></uni-id-pages-x-input>
			<uni-id-pages-x-input class="my-input" title="密码" v-model="data.password" :password="true" ref="passwordRef"></uni-id-pages-x-input>
			<uni-id-pages-x-agreements class="agreements-box" ref="agreementsRef" scope="login" />
			<button class="uni-btn" :type="data.password.length > 0 && data.username.length > 0 ? 'primary' : ''" @click="loginByPwd">登录</button>
		</view>

		<view class="link-group">
			<text class="link link-group-link" @click="toRetrievePwd">忘记密码</text>
			<text class="link link-group-link" @click="toRegister">注册账号</text>
		</view>

		<uni-popup-captcha ref="popupCaptchaRef" scene="login-by-pwd" v-model="data.loginCaptcha" title="请输入验证码"></uni-popup-captcha>
	</view>
</template>

<script setup lang="uts">
	import { state } from '@/uni_modules/uni-id-pages-x/store.uts';
	import { loginSuccess } from '@/uni_modules/uni-id-pages-x/common/common.uts';

	const uniIdCo = uniCloud.importObject("uni-id-co", { customUI: true })
	const usernameRef = ref<UniIdPagesXInputComponentPublicInstance | null>(null)
	const passwordRef = ref<UniIdPagesXInputComponentPublicInstance | null>(null)
	const agreementsRef = ref<UniIdPagesXAgreementsComponentPublicInstance | null>(null)
	const popupCaptchaRef = ref<UniPopupCaptchaComponentPublicInstance | null>(null)
	const data = reactive({
		username: "",
		password: "",
		needCaptcha: false,
		loginCaptcha: ""
	})

	function showPopupCaptcha(callback : () => void) {
		agreementsRef.value!.showPopupAgreements(callback)
	}

	async function loginByPwd() : Promise<any> {
		if (data.username.length == 0) {
			usernameRef.value!.setFocus(true)
			return uni.showToast({
				title: '请输入手机号/用户名/邮箱',
				icon: 'none',
				duration: 3000
			})
		}
		if (data.password.length == 0) {
			passwordRef.value!.setFocus(true)
			return uni.showToast({
				title: '请输入密码',
				icon: 'none',
				duration: 3000
			})
		}
		if (data.needCaptcha && data.loginCaptcha.length != 4) {
			popupCaptchaRef.value!.open(() => {
				loginByPwd()
			})
			return uni.showToast({
				title: '请输入验证码',
				icon: 'none',
				duration: 3000
			})
		}

		const data : UTSJSONObject = {
			"password": data.password,
			"captcha": data.loginCaptcha
		}

		let keyName = 'username'
		if (/^1\d{10}$/.test(data.username)) {
			keyName = "mobile"
		} else if (/@/.test(data.username)) {
			keyName = "email"
		}
		data.set(keyName, data.username)

		console.log('data', state.pendingAgreements)

		if (state.pendingAgreements) {
			showPopupCaptcha(() => {
				if (!state.pendingAgreements) {
					loginByPwd()
				}
			})
			return false
		}

		uni.showLoading({
			title: '登录中',
			mask: false
		})

		const testRes = await new Promise((resolve) => {
			uniIdCo.login(data)
				.finally(() : void => {
					uni.hideLoading()
					data.loginCaptcha = ""
				})
				.then((e) => {
					console.log('uniIdCo.login res', e)
					loginSuccess(e)
					resolve(e['uid'])
				})
				.catch<void>((err : any | null) : void => {
					const error = err as UniCloudError
					console.error(error)
					console.error(error.code)
					if (error.code == 'uni-id-captcha-required') {
						data.needCaptcha = true
						popupCaptchaRef.value!.open(() => {
							loginByPwd()
						})
					} else {
						uni.showToast({
							title: error.message,
							icon: 'none',
							duration: 3000
						})
					}
					resolve({ errCode: error.errCode, errMsg: error.errMsg })
				})
		})
		console.log('testRes: ', testRes)
		return testRes
	}

	function toRegister() {
		uni.navigateTo({
			url: "/uni_modules/uni-id-pages-x/pages/register/register"
		})
	}

	function toRetrievePwd() {
		let url = "/uni_modules/uni-id-pages-x/pages/retrieve/retrieve"
		if (/^1\d{10}$/.test(data.username)) {
			url += "?mobile=" + data.username
		} else if (/@/.test(data.username)) {
			url += "?email=" + data.username
		}
		uni.navigateTo({ url })
	}

	onMounted(() => {
		setTimeout(() => {
			usernameRef.value!.setFocus(true)
		}, 300)
	})
	
	defineExpose({
		data,
		toRegister,
		toRetrievePwd,
		loginByPwd
	})
</script>

<style lang="scss" scoped>
	@import url("/uni_modules/uni-id-pages-x/common/common.scss");
	.pwd-login-title {
		font-size: 14px;
		font-weight: 700;
	}

	.link-group {
		flex-direction: row;
		width: 600rpx;
		margin-left: 75rpx;
		margin-top: 15px;
		justify-content: space-between;
	}

	.link-group-link {
		color: #083679;
		font-size: 12px;
	}
</style>
