<template>
	<view>
		<text class="tip">未注册的账号验证通过后将自动注册</text>

		<view class="form">
			<uni-id-pages-x-smsCode ref="smsCodeRef" class="test-smsCode" @input="smsCodeInput"
				:checkAgreements="true"></uni-id-pages-x-smsCode>
			<uni-id-pages-x-agreements class="agreements-box" ref="agreementsRef" scope="login" />
			<button class="uni-btn" type="primary" @click="sendSmsCode">获取手机验证码</button>
		</view>

		<uni-popup-captcha ref="captchaRef" scene="login-by-sms" v-model="captcha" title="请输入验证码"></uni-popup-captcha>
	</view>
</template>

<script setup lang="uts">
	type TypeTestErr = {
		errCode : string,
		errMsg : string
	}

	type TypeTestSuccess = {
		errCode : number | null,
		uid : string,
		newToken ?: string,
		passwordConfirmed ?: boolean | null
	}

	type TypeData = {
		testErr : TypeTestErr,
		testSuccess : TypeTestSuccess,
		testState : boolean
	}

	import { loginSuccess } from '@/uni_modules/uni-id-pages-x/common/common.uts';

	const uniIdCo = uniCloud.importObject("uni-id-co", { "customUI": true })
	const smsCodeRef = ref<UniIdPagesXSmsCodeComponentPublicInstance | null>(null)
	const agreementsRef = ref<UniIdPagesXAgreementsComponentPublicInstance | null>(null)
	const captchaRef = ref<UniPopupCaptchaComponentPublicInstance | null>(null)
	const captcha = ref("")
	const data = reactive({
		testErr: {
			errCode: '',
			errMsg: ''
		} as TypeTestErr,
		testSuccess: {
			errCode: null,
			uid: '',
			newToken: '',
			passwordConfirmed: null
		} as TypeTestSuccess,
		testState: false
	} as TypeData)

	function sendSmsCode() {
		smsCodeRef.value!.sendSmsCode()
	}

	function smsCodeInput(param : UTSJSONObject) {
		const mobile = param.getString("mobile") as string
		const code = param.getString("code") as string
		if (mobile.length == 11 && code.length == 6) {
			login(param)
		}
	}

	function showPopupCaptcha(callback : () => void) {
		openAgreementsPopup(callback)
	}

	function openAgreementsPopup(callback : () => void) {
		agreementsRef.value!.showPopupAgreements(callback)
	}

	function openCaptchaPopup(callback : () => void) {
		if (captchaRef.value == null) {
			return
		}
		captchaRef.value!.open(callback)
	}

	async function login(param : UTSJSONObject) : Promise<any> {
		uni.showLoading({ "title": "登录中" })
		console.log('param',param)
		const testRes = await new Promise((resolve) => {
			uniIdCo.loginBySms(param)
				.finally(() : void => {
					uni.hideLoading()
				})
				.then<void>((e : UTSJSONObject) : void => {
					console.log('e----',e)
					smsCodeRef.value!.hideCodeInput()
					uni.showToast({
						title: '登录成功',
						icon: 'none'
					})
					data.testState = true
					data.testSuccess.uid = e['uid'] as string
					data.testSuccess.errCode = e['errCode'] as number
					smsCodeRef.value!.clearCodeInput()
					loginSuccess(e)
					resolve(e)
				})
				.catch<void>((err : any | null) : void => {
					data.testState = true
					const error = err as UniCloudError
					let errCode = error.errCode
					if (errCode == null) {
						errCode = error.code
					}
					let errMsg = error.errMsg
					if (errMsg == null) {
						errMsg = error.message
					}
					console.error(error)
					console.error(error.code)
					if (["uni-id-captcha-required", "uni-captcha-verify-fail"].includes(error.code as string)) {
						openCaptchaPopup(() => {
							login(param)
						})
					} else {
						uni.showToast({
							title: error.message,
							icon: 'none',
							mask: false
						})
						smsCodeRef.value!.clearCodeInput()
						captcha.value = ""
					}
					data.testErr.errCode = errCode as string
					data.testErr.errMsg = errMsg as string
					console.log(JSON.stringify(data.testErr))
					resolve({ errCode: errCode, errMsg: errMsg })
				})
		})
		return testRes
	}

	function loginBySmsCodeForTest(paramString : string) : Promise<any> {
		const param = JSON.parseObject(paramString)!
		return login(param)
	}

	defineExpose({
		data,
		showPopupCaptcha,
		loginBySmsCodeForTest
	})
</script>

<style>
	.tip {
		font-size: 12px;
		margin-bottom: 10px;
	}
</style>
