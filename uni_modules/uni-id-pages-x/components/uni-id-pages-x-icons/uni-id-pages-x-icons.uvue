<template>
	<view>
		<text class="uni-id-icon" :style="{ color, 'fontSize': size + 'px' }">{{ iconCode }}</text>
	</view>
</template>

<script setup lang="uts">
	const props = defineProps({
		type: {
			type: String,
			default: "",
			required: true
		},
		color: {
			type: String,
			default: "#ccc"
		},
		size: {
			type: Number,
			default: 16
		}
	})

	const iconCode = computed(() : string => {
		const iconCodeMap : UTSJSONObject = {
			"clear": "\ue622",
			"down": "\ue600",
			"right-arrow": "\ue8f1",
			"jiahao": "\ue602",
			"eyes": "\ue62b",
			"advert": "\ue609"
		}
		return iconCodeMap.getString(props.type) as string
	})

	const color = computed(() : string => {
		return props.color
	})

	const size = computed(() : number => {
		return props.size
	})
</script>

<style>
	@font-face {
		font-family: "uni-id-icon";
		src: url('/uni_modules/uni-id-pages-x/static/fonts/uni-id-icon.ttf');
	}

	.uni-id-icon {
		font-family: "uni-id-icon";
		font-size: 16px;
		font-style: normal;
	}
</style>
