<template>
	<view class="input-box" :class="{ border }">
		<text v-if="hasTitleAndContent" class="title">{{ title }}</text>
		<input class="input" ref="inputRef" :placeholder="placeholderText" :class="{ 'input-move-down': hasTitleAndContent }"
			:value="modelValue" @input="updateValue" :type="type" :maxlength="maxlength"
			:password="password && !visiblePwd" :focus="focus" @blur="onBlur" @focus="onFocus" @confirm="confirm"
			:confirm-type="confirmType" />
		<view class="my-input-icon-box" v-if="modelValue">
			<uni-id-pages-x-icons v-if="password" :color="visiblePwd ? '#0070ff' : '#ddd'"
				@click="setVisiblePwd('click')" @touchstart="setVisiblePwd('touchstart')" @touchend="setVisiblePwd('touchend')"
				@touchcancel="setVisiblePwd('touchcancel')" type="eyes" />
			<view class="password-icon">
				<uni-id-pages-x-icons @click="clearValue" type="clear" color="#ddd" />
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	const emit = defineEmits(['update:modelValue', 'blur', 'focus', 'confirm'])
	const props = defineProps({
		title: {
			type: String,
			default: ""
		},
		modelValue: {
			type: String,
			default: ""
		},
		type: {
			type: String,
			default: "text"
		},
		placeholder: {
			type: String,
			default: ""
		},
		maxlength: {
			type: Number,
			default: 140
		},
		password: {
			type: Boolean,
			default: false
		},
		focus: {
			type: Boolean,
			default: false
		},
		border: {
			type: Boolean,
			default: false
		},
		confirmType: {
			type: String,
			default: "done"
		},
		visiblePwdOption: {
			type: String,
			default: "click"
		}
	})

	const inputRef = ref<Element | null>(null)
	const visiblePwd = ref(false)

	const title = computed(() : string => {
		return props.title
	})

	const modelValue = computed(() : string => {
		return props.modelValue
	})

	const type = computed(() : string => {
		return props.type
	})

	const maxlength = computed(() : number => {
		return props.maxlength
	})

	const password = computed(() : boolean => {
		return props.password
	})

	const focus = computed(() : boolean => {
		return props.focus
	})

	const border = computed(() : boolean => {
		return props.border
	})

	const confirmType = computed(() : string => {
		return props.confirmType
	})

	const placeholderText = computed(() : string => {
		if (props.placeholder.length > 0) {
			return props.placeholder
		}
		if (props.title.length > 0) {
			return "请输入" + props.title
		}
		return ""
	})

	const hasTitleAndContent = computed(() : boolean => {
		return props.title.length > 0 && props.modelValue.length > 0
	})

	function updateValue(event : InputEvent) {
		emit('update:modelValue', event.detail.value)
	}

	function clearValue() {
		emit('update:modelValue', '')
		setFocus(true)
	}

	function onBlur() {
		emit('blur')
	}

	function onFocus() {
		emit('focus')
	}

	function setFocus(state : boolean) {
		if (state) {
			inputRef.value!.focus()
		} else {
			inputRef.value!.blur()
		}
	}

	function confirm(event : InputConfirmEvent) {
		emit('confirm', event)
	}

	function setVisiblePwd(eventName : string) {
		if (eventName == "click" && props.visiblePwdOption == 'click') {
			visiblePwd.value = !visiblePwd.value
		} else if (props.visiblePwdOption == "touch") {
			switch (eventName) {
				case "touchstart":
					visiblePwd.value = true
					break
				case "touchend":
					visiblePwd.value = false
					break
				case "touchcancel":
					visiblePwd.value = false
					break
			}
		}
	}

	defineExpose({
		setFocus
	})
</script>

<style lang="scss" scoped>
	.input-box {
		position: relative;
		margin: 0;
		background-color: #F8F8F8;
		height: 50px !important;
		border-radius: 5rpx;
	}

	.border {
		border: 1px solid #86868b;
	}

	.input {
		border-radius: 5px;
		height: 50px;
		padding: 0 16rpx 0 12px;
		font-size: 14px;
		top: 0;
		position: relative;
	}

	.title {
		position: absolute;
		top: 0;
		left: 16rpx;
		color: #555;
		font-weight: 400;
		font-size: 12px;
		padding-left: 5px;
		height: 30px;
		line-height: 30px;
	}

	.input-move-down {
		top: 22px;
		height: 22px;
	}

	.my-input-icon-box {
		position: absolute;
		right: 10px;
		bottom: 14px;
		flex-direction: row;
	}

	.password-icon {
		margin-left: 5px;
	}
</style>
