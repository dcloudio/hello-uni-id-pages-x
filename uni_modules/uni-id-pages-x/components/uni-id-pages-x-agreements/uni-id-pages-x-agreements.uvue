<template>
	<view class="agreements-root" v-if="agreements.length != 0">
		<template v-if="data.needAgreements">
			<checkbox-group @change="setAgree">
				<checkbox class="checkbox" style="transform: scale(0.7);margin-right: -6px;padding-right: 3px;margin-left: 1px;"
					:checked="!pendingAgreements" value="agreement">
					<text class="checkbox-text">同意</text>
				</checkbox>
			</checkbox-group>
			<view class="content">
				<view class="agreements-item" v-for="(agreement,index) in agreements" :key="index">
					<text class="agreement text" @click="navigateTo(index)">{{ agreement.title }}</text>
					<text class="text and" v-if="hasAnd(index)"> 和 </text>
				</view>
			</view>
		</template>

		<uni-popup ref="popupRef">
			<view class="popup-content" ref="popupBoxRef">
				<view class="popup-header">
					<uni-id-pages-x-icons :size="18" color="#E6A23C" type="advert" />
					<text class="popup-title">请先阅读并同意</text>
				</view>
				<view class="content">
					<view class="agreements-item" v-for="(agreement,index) in agreements" :key="index">
						<text class="agreement popup-text" @click="navigateTo(index)">{{ agreement.title }}</text>
						<text class="popup-text and" v-if="hasAnd(index)"> 和 </text>
					</view>
				</view>
				<view class="btn-group popup-btn-group">
					<text class="btn popup-btn" @click="cancel">取消</text>
					<text class="btn confirm popup-btn popup-btn-confirm" @click="confirm">同意</text>
				</view>
			</view>
		</uni-popup>
	</view>
</template>

<script setup lang="uts">
	import config from '@/uni_modules/uni-id-pages-x/config.uts';
	import { state } from '@/uni_modules/uni-id-pages-x/store.uts';

	type Agreement = {
		url : string,
		title : string
	}

	let confirmCallBack = () : void => {}

	const props = defineProps({
		scope: {
			type: String,
			default: "login"
		}
	})

	const popupRef = ref<UniPopupComponentPublicInstance | null>(null)
	const popupBoxRef = ref<UniElement | null>(null)
	// 使用 reactive，便于自动化测试直接读取组件数据
	const data = reactive({
		needAgreements: true
	})

	const agreements = computed(() : Agreement[] => {
		const agreements = config.getJSON('agreements')
		if (agreements === null) {
			return []
		}
		return [{
			"url": agreements.getString('serviceUrl') as string,
			"title": "用户服务协议"
		},
		{
			"url": agreements.getString('privacyUrl') as string,
			"title": "隐私政策条款"
		}] as Agreement[]
	})

	const pendingAgreements = computed(() : boolean => {
		return state.pendingAgreements
	})

	function hasAnd(index : number) : boolean {
		return agreements.value.length - 1 > index
	}

	function navigateTo(index : number) {
		const title = agreements.value[index].title
		const url = agreements.value[index].url
		uni.navigateTo({
			"url": "/uni_modules/uni-id-pages-x/pages/common/webview/webview?url=" + url + "&title=" + title,
			fail: (e) => {
				console.error(e)
			}
		})
	}

	function setAgree(event : CheckboxGroupChangeEvent) {
		state.pendingAgreements = event.detail.value.length == 0
	}

	function showPopupAgreements(callback : () => void) {
		confirmCallBack = callback
		popupRef.value!.open()
	}

	function cancel() {
		state.pendingAgreements = true
		popupRef.value!.close()
	}

	function confirm() {
		state.pendingAgreements = false
		confirmCallBack()
		popupRef.value!.close()
	}

	onMounted(() => {
		const scopeList = config.getArray<string>('agreements.scopeList')
		if (scopeList == null) {
			data.needAgreements = false
		} else {
			data.needAgreements = scopeList.includes(props.scope)
		}
		state.pendingAgreements = data.needAgreements

		uni.$on("uni-id-pages-x-agreements-shake", () => {
			popupBoxRef.value?.style.setProperty("top", 0)
		})
	})

	defineExpose({
		data,
		confirm,
		showPopupAgreements
	})
</script>

<style lang="scss" scoped>
	.agreements-root {
		flex-direction: row;
		align-items: center;
		justify-content: flex-start;
		margin-left: -9px;
	}

	.checkbox-text {
		transform: scale(1.3);
		margin-left: 3px;
		color: #8a8f8b;
		font-size: 12px;
	}

	.agreements-item {
		flex-direction: row;
	}

	.text {
		line-height: 26px;
		font-size: 12px;
	}

	.popup-text {
		line-height: 30px;
		font-size: 14px;
	}

	.agreement {
		color: #04498c;
		/* #ifdef WEB */
		cursor: pointer;
		/* #endif */
	}

	.content {
		padding: 5px 0;
		flex-wrap: wrap;
		flex-direction: row;
	}

	.popup-content {
		background-color: #FFF;
		padding-bottom: 0;
		border-radius: 10px;
		width: 600rpx;
		padding: 15px;
	}

	.popup-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding-top: 5px;
	}

	.popup-title {
		font-size: 16px;
		margin: 15px 0;
		padding-left: 5px;
	}

	.popup-btn-group {
		border-top: 1px solid #eee;
		flex-direction: row;
		justify-content: space-around;
		margin-top: 10px;
	}

	.popup-btn {
		flex: 1;
		text-align: center;
		color: #666;
		height: 45px;
		line-height: 45px;
		font-size: 14px;
	}

	.popup-btn-confirm {
		color: #115ff7;
		border-left: solid 1px #eee;
	}
</style>
