<template>
	<view>
		<view class="mobile-box">
			<view @click="chooseArea" class="area">
				<text>+86</text>
				<uni-id-pages-x-icons :size="10" color="#666" @click="chooseArea" type="down" />
			</view>
			<view class="input-box mobile-box-input-box">
				<uni-id-pages-x-input type="number" :border="false" v-model="data.mobile" :maxlength="11" placeholder="请输入11位手机号"
					ref="mobileInputRef"></uni-id-pages-x-input>
			</view>
		</view>
		<view class="send-sms-captcha-box">
			<uni-captcha ref="sendSmsCaptchaRef" scene="send-sms-code" v-model="data.sendSmsCaptcha" />
		</view>
		<fab-sms-code-input v-model="data.smsCode" :mobile="data.mobile" :reverseNumber="reverseNumber" ref="fabSmsCodeInputRef"
			@reGetSmsCode="reGetSmsCode" title="验证并登录" />
	</view>
</template>

<script setup lang="uts">
	import fabSmsCodeInput from './fab-sms-code-input.uvue';
	import { state } from '@/uni_modules/uni-id-pages-x/store.uts';

	const emit = defineEmits(['input'])
	const props = defineProps({
		scene: {
			type: String,
			default: "login-by-sms"
		},
		autoSend: {
			type: Boolean,
			default: true
		},
		checkAgreements: {
			type: Boolean,
			default: false
		}
	})

	const currentInstance = getCurrentInstance()
	const fabSmsCodeInputRef = ref<ComponentPublicInstance | null>(null)
	const sendSmsCaptchaRef = ref<UniCaptchaComponentPublicInstance | null>(null)
	const mobileInputRef = ref<UniIdPagesXInputComponentPublicInstance | null>(null)
	const data = reactive({
		mobile: "",
		sendSmsCaptcha: "",
		smsCode: ""
	})
	const reverseNumber = ref(0)

	function setMobileInputFocus(val : boolean) {
		mobileInputRef.value!.setFocus(val)
	}

	function showCodeInput() {
		if (reverseNumber.value == 0) {
			reverseNumber.value = 6
			let reverseTimer = function () {}
			reverseTimer = () => {
				if (reverseNumber.value != 0) {
					reverseNumber.value--
					setTimeout(() => {
						reverseTimer()
					}, 1000)
				}
			}
			reverseTimer()
		}
		(fabSmsCodeInputRef.value as FabSmsCodeInputComponentPublicInstance).show()
	}

	function emitInput() {
		const param : UTSJSONObject = {
			"mobile": data.mobile,
			"code": data.smsCode,
			"sendSmsCaptcha": data.sendSmsCaptcha
		}
		emit('input', param)
	}

	function chooseArea() {
		uni.showToast({
			title: "目前只支持中国",
			icon: "none"
		})
	}

	function reGetSmsCode() {
		hideCodeInput()
		clearCodeInput()
		sendSmsCaptchaRef.value!.getImageCaptcha(true)
	}

	function hideCodeInput() {
		(fabSmsCodeInputRef.value as FabSmsCodeInputComponentPublicInstance).hide()
	}

	function clearCodeInput() {
		(fabSmsCodeInputRef.value as FabSmsCodeInputComponentPublicInstance).clear()
	}

	function reset() {
		data.smsCode = ""
		data.sendSmsCaptcha = ""
		clearCodeInput()
		hideCodeInput()
	}

	function sendSmsCode() {
		if (props.checkAgreements && state.pendingAgreements) {
			sendSmsCaptchaRef.value!.setFocus(false)
			const parent = currentInstance?.proxy?.$parent as ComponentPublicInstance | null
			if (parent != null) {
				parent.$callMethod("showPopupCaptcha", () => {
					if (!state.pendingAgreements) {
						sendSmsCode()
					}
				})
			}
			uni.showToast({
				title: '未同意隐私政策协议',
				icon: 'none'
			})
			return
		}

		if (reverseNumber.value != 0) {
			return showCodeInput()
		}

		const reg_mobile = /^1\d{10}$/
		if (!reg_mobile.test(data.mobile)) {
			mobileInputRef.value!.setFocus(true)
			uni.showToast({
				title: "手机号格式错误",
				icon: 'none',
				duration: 3000
			})
			return
		}

		if (data.sendSmsCaptcha.length != 4) {
			sendSmsCaptchaRef.value!.setFocus(true)
			uni.showToast({
				title: '请先输入图形验证码',
				icon: 'none',
				duration: 3000
			})
			return
		}

		uni.showLoading({ "title": "发送中" })
		const uniIdCo = uniCloud.importObject("uni-id-co", { "customUI": true })
		uniIdCo.sendSmsCode({
			"mobile": data.mobile,
			"scene": props.scene,
			"captcha": data.sendSmsCaptcha
		})
			.finally(() : void => {
				uni.hideLoading()
			})
			.then((_ : UTSJSONObject) => {
				uni.showToast({
					title: "短信验证码发送成功",
					icon: 'none',
					duration: 3000
				})
				showCodeInput()
			})
			.catch<void>((err : any | null) : void => {
				const error = err as UniCloudError
				switch (error.code) {
					case "uni-captcha-verify-fail":
						uni.showToast({
							title: error.message,
							icon: 'none',
							duration: 3000,
							mask: false
						})
						sendSmsCaptchaRef.value!.getImageCaptcha(true)
						data.sendSmsCaptcha = ""
						break
					case "uni-id-invalid-sms-template-id":
						showCodeInput()
						uni.showToast({
							title: ' 当前为测试模式,详情【控制台信息】',
							icon: 'none',
							duration: 3000
						})
						console.warn(error.message)
						break
					default:
						uni.showToast({
							title: error.message,
							icon: 'none',
							duration: 3000
						})
						break
				}
			})
	}

	watch(() => data.mobile, (value : string) => {
		emitInput()
		if (value.length == 11) {
			sendSmsCaptchaRef.value!.setFocus(true)
			reverseNumber.value = 0
		}
	})

	watch(() => data.sendSmsCaptcha, () => {
		emitInput()
		if (props.autoSend && data.sendSmsCaptcha.length == 4 && data.mobile.length == 11) {
			sendSmsCode()
		}
	})

	watch(() => data.smsCode, () => {
		emitInput()
	})

	onMounted(() => {
		setTimeout(() => {
			setMobileInputFocus(true)
		}, 300)
	})

	defineExpose({
		data,
		sendSmsCode,
		hideCodeInput,
		clearCodeInput,
		reset
	})
</script>

<style>
	.mobile-box {
		position: relative;
		flex-direction: row;
		background-color: #F8F8F8;
		justify-content: center;
		align-items: center;
		border-radius: 5rpx;
	}

	.area {
		width: 90rpx;
		justify-content: space-around;
		align-items: center;
		flex-direction: row;
		margin-left: 10px;
	}

	.mobile-box-input-box {
		flex: 1;
	}

	.send-sms-captcha-box {
		margin-top: 10px;
	}
</style>
